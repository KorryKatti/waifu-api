# Copy to .env and fill in. .env is gitignored - never commit real keys.
# chmod 600 .env
#
# Works with any S3-compatible provider. Swap the five S3_* values to move
# between IDrive e2, Backblaze B2, Cloudflare R2, Tigris, etc.

# --- IDrive e2 (https://www.idrive.com/e2) ---
# Create a bucket first, then generate an S3-compatible API key pair
# in the e2 dashboard. Endpoint + region come from the bucket's region.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=waifu-images
S3_ENDPOINT=https://s3.ap-northeast-1.idrivee2.com
S3_REGION=ap-northeast-1

# Public base URL the API should emit as Cdn__BaseUrl.
# Set this to the bucket's own public URL for now; swap for a custom domain later.
# No trailing slash.
CDN_BASE_URL=

# --- Supabase ---
# Project Settings > Database > Connection string > URI (use the "direct" one)
# Password needs URL-encoding if it contains special characters.
DATABASE_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres

# --- Backblaze B2 (fallback) ---
# https://s3.us-west-004.backblazeb2.com  region: us-west-004
# Public base URL looks like: https://f005.backblazeb2.com/file/<bucket>
# IDRIVE_ENDPOINT=https://s3.us-west-004.backblazeb2.com
# IDRIVE_REGION=us-west-004
# IDRIVE_BUCKET=waifu-images