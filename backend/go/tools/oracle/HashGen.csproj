<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>HashGen</RootNamespace>
    <AssemblyName>HashGen</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Versions pinned to EXACTLY what the original C# service declared.
      Any drift here invalidates the golden vectors.
    -->
    <PackageReference Include="CoenM.ImageSharp.ImageHash" Version="1.3.6" />
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.12" />
  </ItemGroup>

</Project>