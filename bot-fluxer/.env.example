# Fluxer bot token.
FLUXER_TOKEN=

# Command prefix.
PREFIX=!

# The Cloudflare Worker. Every anonymous read goes here, where it is cached at
# the edge for 60 seconds.
WAIFU_API=https://waifu-cdn.waifu-api.workers.dev

# The API host itself. Used only by !register, because the Worker drops
# X-Api-Key. No fallback: leave it empty and !register refuses rather than send
# a credential to the CDN.
WAIFU_ORIGIN=https://waifu-api-031n.onrender.com

# Extra channel IDs allowed to receive NSFW results. Only needed for channels
# that are not already marked age-restricted in Fluxer.
NSFW_CHANNELS=

# Needed only by !register. Create it as an admin account.
WAIFU_ADMIN_API_KEY=

# Role granted after a successful registration. Leave empty to grant nothing.
INSTANCE_OPERATOR_ROLE=

# One registration per hour, across the whole server.
REGISTER_COOLDOWN_SECONDS=3600

# How often !instances re-measures latency. 0 switches the sweep off.
INSTANCE_PING_SECONDS=3600

# Minimum gap between !instances needed measurements, across the whole server.
INSTANCE_PING_COOLDOWN_SECONDS=3600

# Where register_log.json and instance_ping_log.json live.
BOT_STATE_DIR=.

# Optional Fluxer endpoint overrides.
# FLUXER_API=https://api.fluxer.app/v1
# FLUXER_GATEWAY=wss://gateway.fluxer.app/?v=1&encoding=json
