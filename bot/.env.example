DISCORD_TOKEN=your-bot-token-here

# optional overrides
PREFIX=!

# The Cloudflare Worker. It caches anonymous reads at the edge for 60s, so a
# repeat command is answered from the cache rather than the database. Point it
# at https://waifu-api-031n.onrender.com to bypass the cache.
#
# Only correct for anonymous bots: the Worker forwards Authorization but drops
# X-Api-Key, so an API-key client pointed here is silently unauthenticated.
# Use the API host for anything that sends credentials.
WAIFU_API=https://waifu-cdn.waifu-api.workers.dev

# The API host, used only by the keep-alive probe. Images still come from the
# Worker, where the cache is the point.
#
# Leave this set. The probe runs every 60s and the edge caches /ping for 60s,
# so probing through the Worker only reaches Render about half the time, and
# Render spins down when it stops hearing from us.
WAIFU_ORIGIN=https://waifu-api-031n.onrender.com

# Extra channel IDs allowed to receive NSFW results.
# Only needed for channels NOT marked age-restricted in Discord itself.
NSFW_CHANNELS=
# Only needed for the /register slash command. Registration is admin-gated, so
# this key must belong to an admin account.
#
# Create it once, while logged in as an admin:
#
#   POST /auth/api-keys   {"description": "waifu bot", "expiresInDays": 0}
#
# expiresInDays 0 means it does not expire, which is what a service credential
# should be: revocable rather than expiring. The plaintext is returned once and
# cannot be recovered - only its hash is stored - so if it is lost, delete the
# key and create another.
#
# An API key rather than a JWT, because a JWT is signed with the service's
# signing key and lasts 24 hours, so the bot would need a new one daily and would
# fail quietly when it lapsed.
#
# Registration must point at the API host, not the Worker: the Worker forwards
# Authorization but drops X-Api-Key, so a key sent through it is silently
# anonymous.
WAIFU_ADMIN_API_KEY=

# The role granted to somebody whose instance is on the index. Leave empty to
# register without granting anything - the command says so rather than appearing
# to have granted a role it did not.
INSTANCE_OPERATOR_ROLE=
