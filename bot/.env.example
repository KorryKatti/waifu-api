DISCORD_TOKEN=your-bot-token-here

# optional overrides
PREFIX=!

# The Cloudflare Worker. It caches anonymous reads at the edge for 60s, so a
# repeat command is answered from the cache rather than the database. Point it
# at https://waifu-api-031n.onrender.com to bypass the cache.
#
# Only correct for anonymous bots: the Worker forwards Authorization but drops
# X-Api-Key, so an API-key client pointed here is silently unauthenticated.
# Use the API host for anything that sends credentials.
WAIFU_API=https://waifu-cdn.waifu-api.workers.dev

# The API host, used only by the keep-alive probe. Images still come from the
# Worker, where the cache is the point.
#
# Leave this set. The probe runs every 60s and the edge caches /ping for 60s,
# so probing through the Worker only reaches Render about half the time, and
# Render spins down when it stops hearing from us.
WAIFU_ORIGIN=https://waifu-api-031n.onrender.com

# Extra channel IDs allowed to receive NSFW results.
# Only needed for channels NOT marked age-restricted in Discord itself.
NSFW_CHANNELS=
# Only needed for the /register slash command. Registration is admin-gated, so
# this key must belong to an admin account.
#
# Create it once, while logged in as an admin:
#
#   POST /auth/api-keys   {"description": "waifu bot", "expiresInDays": 0}
#
# expiresInDays 0 means it does not expire, which is what a service credential
# should be: revocable rather than expiring. The plaintext is returned once and
# cannot be recovered - only its hash is stored - so if it is lost, delete the
# key and create another.
#
# An API key rather than a JWT, because a JWT is signed with the service's
# signing key and lasts 24 hours, so the bot would need a new one daily and would
# fail quietly when it lapsed.
#
# Registration must point at the API host, not the Worker: the Worker forwards
# Authorization but drops X-Api-Key, so a key sent through it is silently
# anonymous.
WAIFU_ADMIN_API_KEY=

# Who may run the commands that send that credential: /me, /permissions,
# /albums, /keys, /review, /reports, /adminstats and /diff. Comma-separated
# Discord account ids.
#
# This is an allowlist and it is empty by default, which means those commands
# refuse and say why. That is deliberate: the key belongs to an admin account
# and can delete images, approve review tasks and ban users, so a bot in a server
# with other people in it must not hand that to whoever asks nicely. A role or a
# permission would be wrong here, because either can be granted to somebody who
# then holds an admin credential by accident.
#
# Every reply from these commands is ephemeral regardless, so nothing they
# return stays in a channel's scrollback.
WAIFU_DEBUG_USERS=

# The credential the commands above authenticate with. Defaults to
# WAIFU_ADMIN_API_KEY when unset.
#
# Worth pointing at a lesser account. Those commands mostly read, and an admin
# key is not needed to read. Both values are scrubbed from anything the bot logs
# or posts, so keeping them distinct does not weaken that.
WAIFU_API_TEST_KEY=

# The role granted to somebody whose instance is on the index. Leave empty to
# register without granting anything - the command says so rather than appearing
# to have granted a role it did not.
INSTANCE_OPERATOR_ROLE=

# How long one registration blocks the next, across the whole server. The
# default is an hour. Lower it only if you know why you are lowering it: the
# limit protects the backend from having its probe endpoint used as a fetch
# proxy, and per-person limits would not.
REGISTER_COOLDOWN_SECONDS=3600

# How often /instances re-measures how long each listed instance takes to
# answer. The default is hourly, which is on purpose: a request to a listed
# instance is a request to somebody else's free-tier deployment, and a sleeping
# one has to cold-start to answer it. A fifteen-minute sweep kept those
# instances marginally warm all day for a number that barely moves.
#
# This is a background sweep, not work done inside the command: /instances is
# public, and measuring there would let anybody in the server choose when the
# bot dials someone else's server.
#
# It measures from this bot's host, which is not the index's vantage point and
# not the reader's. Set 0 to switch the sweep off; the command then reports the
# index alone and says so, and needed:true still works.
INSTANCE_PING_SECONDS=3600

# Minimum gap between `needed:true` measurements, across the whole server.
#
# Deliberately the same as the sweep interval: a forced measurement is worth
# exactly as much as a scheduled one, so allowing more of them than the schedule
# already provides would make the schedule pointless.
INSTANCE_PING_COOLDOWN_SECONDS=3600
