DISCORD_TOKEN=your-bot-token-here

# optional overrides
PREFIX=!

# The Cloudflare Worker. It caches anonymous reads at the edge for 60s, so a
# repeat command is answered from the cache rather than the database. Point it
# at https://waifu-api-031n.onrender.com to bypass the cache.
#
# Only correct for anonymous bots: the Worker forwards Authorization but drops
# X-Api-Key, so an API-key client pointed here is silently unauthenticated.
# Use the API host for anything that sends credentials.
WAIFU_API=https://waifu-cdn.waifu-api.workers.dev

# The API host, used only by the keep-alive probe. Images still come from the
# Worker, where the cache is the point.
#
# Leave this set. The probe runs every 60s and the edge caches /ping for 60s,
# so probing through the Worker only reaches Render about half the time, and
# Render spins down when it stops hearing from us.
WAIFU_ORIGIN=https://waifu-api-031n.onrender.com

# Extra channel IDs allowed to receive NSFW results.
# Only needed for channels NOT marked age-restricted in Discord itself.
NSFW_CHANNELS=